{
  "name": "pouyeshgar-data-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vue-tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/server/index.js",
    "simulator": "node dist-server/server/simulator.js",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fastify/static": "8.3.0",
    "aedes": "0.51.3",
    "exceljs": "4.4.0",
    "fastify": "5.12.5",
    "lucide-vue-next": "0.468.0",
    "mariadb": "3.5.4",
    "mqtt": "5.14.1",
    "vue": "3.5.43",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.2",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vue-tsc": "3.1.5"
  }
}
